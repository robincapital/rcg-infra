[Unit]
Description=RCG Daily Forward Returns Markout Service
After=network.target postgresql.service

[Service]
Type=oneshot
User=nixos
WorkingDirectory=/home/nixos/Prod/V1
ExecStart=/usr/bin/python3 /home/nixos/Prod/V1/src/forward_returns_daily.py
StandardOutput=journal
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
